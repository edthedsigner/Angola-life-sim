; Engine configuration file.
; Godot 4.x project for Angola Life Simulator - Multiplayer Foundation

config_version=5

[application]

config/name="Angola Life Simulator"
config/description="Simulador de vida multiplayer persistente ambientado em Angola (Luanda)"
run/main_scene="res://client/scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/placeholders/icon.svg"

[autoload]

WorldData="*res://shared/scripts/WorldData.gd"
NetworkManager="*res://shared/scripts/NetworkManager.gd"
GameState="*res://shared/scripts/GameState.gd"
Art="*res://shared/scripts/Art.gd"
Transition="*res://shared/scripts/Transition.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.13, 0.1, 1)
textures/canvas_textures/default_texture_filter=0
2d/snapping/use_gpu_pixel_snap=true

